{
  "name": "customer-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "typecheck": "vue-tsc -b",
    "lint": "eslint . --max-warnings 0 && cd ../shared && node ../customer-web/node_modules/eslint/bin/eslint.js . --max-warnings 0",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "preview": "vite preview",
    "api:export": "node scripts/export-openapi.mjs",
    "api:generate": "openapi-typescript ../../contracts/openapi.v1.json -o ../shared/src/api/generated/schema.d.ts",
    "api:check": "npm run api:export && npm run api:generate && git diff --exit-code -- ../../contracts/openapi.v1.json ../shared/src/api/generated/schema.d.ts"
  },
  "dependencies": {
    "@doselect/web-shared": "file:../shared",
    "@tanstack/vue-query": "5.101.4",
    "openapi-fetch": "0.17.0",
    "pinia": "4.0.3",
    "primevue": "5.0.1",
    "vue": "3.5.41",
    "vue-router": "5.2.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.3",
    "@vitejs/plugin-vue": "6.0.8",
    "@vitest/coverage-v8": "4.1.10",
    "@vue/test-utils": "2.4.11",
    "@vue/tsconfig": "0.9.1",
    "eslint": "10.8.1",
    "eslint-plugin-vue": "10.10.0",
    "jsdom": "30.0.1",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.0",
    "vitest": "4.1.10",
    "vue-tsc": "3.3.9"
  },
  "allowScripts": {
    "vue-demi@0.14.10": true
  }
}
