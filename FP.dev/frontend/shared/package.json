{
  "name": "@doselect/web-shared",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "api:export": "curl -sf http://localhost:5126/openapi/v1.json -o ../../contracts/openapi.v1.json",
    "api:generate": "node ../customer-web/node_modules/openapi-typescript/bin/cli.js ../../contracts/openapi.v1.json -o src/api/generated/schema.d.ts",
    "api:check": "npm run api:export && npm run api:generate && git diff --exit-code -- ../../contracts/openapi.v1.json src/api/generated/schema.d.ts"
  },
  "exports": {
    "./api": "./src/api/index.ts",
    "./components": "./src/components/index.ts",
    "./query": "./src/query/index.ts"
  },
  "peerDependencies": {
    "@tanstack/vue-query": "5.101.4",
    "openapi-fetch": "0.17.0",
    "vue": "3.5.41"
  }
}
