<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <UserSecretsId>DoSelect.Api-d5a4d9d5-2f17-497e-9592-f787dc7eba5a</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.OpenApi" />
    <PackageReference Include="Scalar.AspNetCore" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Serilog.Sinks.File" />
    <!-- The EF Core CLI (dotnet-ef) resolves design-time services through the startup project
         it is pointed at; it only detects the Design package on that project directly (a
         PrivateAssets="all" reference on DoSelect.Infrastructure does not flow transitively), so
         this project needs its own dev-time-only reference for "dotnet ef database update" to work. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DoSelect.Application\DoSelect.Application.csproj" />
    <ProjectReference Include="..\DoSelect.Infrastructure\DoSelect.Infrastructure.csproj" />
  </ItemGroup>

</Project>
