{
  "ConnectionStrings": {
    "DefaultConnection": "Server=.\\SQL2025;Database=DoSelectDb;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=True;"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Features": {
    "AiEnabled": false,
    "EmailEnabled": false,
    "BackgroundJobsEnabled": false
  },
